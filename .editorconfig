# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,cjs,json,yml,yaml}]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown hard line break, so they must survive.
trim_trailing_whitespace = false

[*.{bat,cmd}]
# The Windows launchers are intentionally GBK-encoded with CRLF endings: they
# pin the console to code page 936 so their Chinese prompts stay readable.
# Do not let an editor "fix" them to UTF-8/LF.
end_of_line = crlf
trim_trailing_whitespace = false